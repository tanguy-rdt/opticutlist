{
  "name": "opticutlist",
  "version": "0.0.0",
  "private": true,
  "description": "Browser application for planning and optimizing rectangular panel cuts.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest",
    "test:unit": "vitest run",
    "build:self-hosted": "vite build --config server/frontend.config.ts && vite build --config server/vite.config.ts",
    "start:self-hosted": "node server-dist/main.js",
    "test:server": "vitest run server/__tests__ --maxWorkers=1"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "konva": "^10.7.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "mdast-util-from-markdown": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
