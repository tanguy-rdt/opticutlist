# Only send production build inputs to Docker.
**
!docker/
!docker/Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.html
!vite.config.ts
!tsconfig*.json
!env.d.ts
!LICENSE
!src/
!src/**
!server/
!server/**
!public/
!public/**

# Keep private/generated files out even when nested inside an allowed directory.
**/.git
**/node_modules
**/.env
**/.env.*
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/*-wal
**/*-shm
**/*-journal
**/*.log
**/*.tsbuildinfo
**/data
**/logs
**/coverage
**/dist
**/dist-self-hosted
**/server-dist
**/.cache
**/.vite
**/.npm
**/.idea
**/.vscode
**/__tests__
**/__fixtures__
**/__snapshots__
**/*.spec.*
**/*.test.*
**/.aws
**/.ssh
**/.codex
**/.agents
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.dump
**/*.bak
**/*.backup
**/*.oclproject.json
**/*.oclstock.json
**/*.oclparts.json
**/*.cocl
